# Copy this file only as a reference. The setup scripts create the real files
# with permissions 0600; do not commit those files.
IDPHOTO_PORT=8080
IDPHOTO_PUSH_PORT=8092
IDPHOTO_ADMIN_PORT=8091
IDPHOTO_DATA_DIR=/absolute/path/to/backend/.miniapp_data
IDPHOTO_ADMIN_PUBLIC_HOST=idphoto-admin.example.com
IDPHOTO_CONTENT_SECURITY_ENABLED=true

# These values belong in .env.miniapp and .env.miniapp.payment, generated by
# the setup scripts. Do not put AppSecret or payment keys in this file.
# WECHAT_APP_ID=wx...
# WECHAT_APP_SECRET=
# IDPHOTO_TOKEN_SECRET=
# WECHAT_OFFER_ID=
# WECHAT_PAY_APP_KEY=
# WECHAT_PUSH_TOKEN=
# WECHAT_PUSH_AES_KEY=
# IDPHOTO_PAYMENT_ENABLED=false
